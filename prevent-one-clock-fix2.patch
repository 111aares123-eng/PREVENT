@@ -0,0 +1,11 @@
+"""
+Shared pytest configuration.
+Must run before any backend module is imported, so the settings object picks these up.
+- Pins the platform clock to the seed scenario reference time: the suite stays deterministic
+  on any date, while the application itself runs on the live wall clock.
+- Points tests at a separate SQLite file so running pytest never wipes the demo database.
+"""
+import os
+
+os.environ["DEFAULT_ANCHOR_TIME"] = "2026-09-17T18:00:00Z"
+os.environ["DATABASE_URL"] = "sqlite:///./prevent_test.db"
diff --git a/tests/test_clock_consistency.py b/tests/test_clock_consistency.py
new file mode 100644
index 0000000..0f0cb87
--- /dev/null
+++ b/tests/test_clock_consistency.py
@@ -0,0 +1,101 @@
+"""
+Clock-consistency tests (live wall clock + seed data rebased onto today).
+
+Guards against seed data and newly entered reports living on different clocks:
+- a report dated "now" must raise, never lower, the risk of an escalating asset
+- a report sent without a timestamp must be stamped with the platform clock
+- What-If must be evaluated on the same clock as the asset page
+- the seeded scenario must score the same on any calendar date once rebased
+"""
+from datetime import datetime, timezone
+import pytest
+from fastapi.testclient import TestClient
+from backend.app.core.config import settings
+from backend.app.main import app
+from data.scenarios.seed_data import seed_database
+
+REPORT = {
+    "event_type": "operational_report",
+    "subsystem": "braking",
+    "severity": 4,
+    "description": "Driver reports long stopping distance in rain.",
+    "source": "driver",
+    "reporter_role": "driver",
+}
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+@pytest.fixture()
+def live_client(monkeypatch):
+    """Demo configuration: live clock, seed scenario rebased onto today."""
+    monkeypatch.setattr(settings, "DEFAULT_ANCHOR_TIME", None)
+    seed_database(reset=True, rebase_to_now=True)
+    with TestClient(app) as client:
+        yield client
+    seed_database(reset=True)
+
+
+def test_live_clock_reproduces_seed_scenario(live_client):
+    data = live_client.get("/api/v1/assets/BUS-142").json()
+    assert data["risk_score"] == pytest.approx(82.0, abs=0.5)
+    assert data["risk_level"] == "HIGH"
+
+
+def test_report_dated_now_never_lowers_risk(live_client):
+    """The UI sends timestamp = now. Adding a warning must not reduce the score."""
+    resp = live_client.post("/api/v1/events", json={"asset_id": "BUS-142", **REPORT, "timestamp": _now_iso()})
+    assert resp.status_code == 201
+    data = resp.json()
+    assert data["previous_risk_score"] == pytest.approx(82.0, abs=0.5)
+    assert data["updated_risk_score"] > data["previous_risk_score"]
+    assert data["updated_risk_level"] in ("HIGH", "CRITICAL")
+
+
+def test_report_dated_now_raises_risk_on_quiet_asset(live_client):
+    data = live_client.post("/api/v1/events", json={"asset_id": "BUS-402", **REPORT, "timestamp": _now_iso()}).json()
+    assert data["updated_risk_score"] > data["previous_risk_score"] + 5.0
+
+
+def test_report_without_timestamp_is_stamped_with_platform_clock(live_client):
+    before = datetime.now(timezone.utc)
+    data = live_client.post("/api/v1/events", json={"asset_id": "BUS-402", **REPORT}).json()
+    stamped = datetime.fromisoformat(data["event"]["timestamp"].replace("Z", "+00:00"))
+    if stamped.tzinfo is None:
+        stamped = stamped.replace(tzinfo=timezone.utc)
+    assert abs((stamped - before).total_seconds()) < 60
+    assert data["updated_risk_score"] > data["previous_risk_score"]
+
+
+def test_timestamp_and_no_timestamp_paths_agree(live_client):
+    """The form (timestamp = now) and the bare API (no timestamp) must give the same result."""
+    with_ts = live_client.post("/api/v1/events", json={"asset_id": "BUS-402", **REPORT, "timestamp": _now_iso()}).json()
+    seed_database(reset=True, rebase_to_now=True)
+    without_ts = live_client.post("/api/v1/events", json={"asset_id": "BUS-402", **REPORT}).json()
+    assert with_ts["updated_risk_score"] == pytest.approx(without_ts["updated_risk_score"], abs=0.2)
+
+
+def test_what_if_after_ingest_uses_one_clock(live_client):
+    live_client.post("/api/v1/events", json={"asset_id": "BUS-402", **REPORT, "timestamp": _now_iso()})
+    current = live_client.get("/api/v1/assets/BUS-402").json()["risk_score"]
+    sim = live_client.post(
+        "/api/v1/simulation/simulate-signal",
+        json={"asset_id": "BUS-402", **REPORT, "event_type": "near_miss", "severity": 5},
+    ).json()
+    assert sim["before_risk_score"] == pytest.approx(current, abs=0.2)
+    assert sim["after_risk_score"] > sim["before_risk_score"]
+
+
+def test_pinned_clock_stamps_missing_timestamp_at_pinned_time():
+    """With DEFAULT_ANCHOR_TIME pinned (test configuration), a missing timestamp uses the pinned instant."""
+    seed_database(reset=True)
+    with TestClient(app) as client:
+        data = client.post("/api/v1/events", json={"asset_id": "BUS-402", **REPORT}).json()
+    stamped = datetime.fromisoformat(data["event"]["timestamp"].replace("Z", "+00:00"))
+    if stamped.tzinfo is None:
+        stamped = stamped.replace(tzinfo=timezone.utc)
+    pinned = datetime.fromisoformat(settings.DEFAULT_ANCHOR_TIME.replace("Z", "+00:00"))
+    assert stamped == pinned
+    seed_database(reset=True)
