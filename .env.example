# PREVENT Environment Configuration Overview
#
# Environment variables are strictly separated between frontend and backend services:
#
# 1. Frontend Configuration:
#    File: frontend/.env (template: frontend/.env.example)
#    Variables:
#      VITE_API_BASE_URL=http://localhost:8000
#
# 2. Backend Configuration:
#    File: backend/.env (template: backend/.env.example)
#    Variables:
#      LLM_PRIMARY=groq
#      LLM_SECONDARY=gemini
#      LLM_FALLBACK=mock
#      GROQ_API_KEY=
#      GROQ_MODEL=openai/gpt-oss-20b
#      GEMINI_API_KEY=
#      GEMINI_MODEL=gemini-2.5-flash
#
# SECURITY NOTICE:
# AI API keys (GROQ_API_KEY, GEMINI_API_KEY) belong exclusively in backend/.env.
# Never expose AI keys to the Vite frontend or prefix them with VITE_*.
